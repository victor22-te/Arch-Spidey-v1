#!/usr/bin/env python3
# ==============================================================================
# SPIDER-MAN 2099 // CONTROL DE VOLUMEN DE MICRÓFONO CON OSD NATIVO DE GNOME
# Ajusta el volumen del micrófono y muestra el indicador píldora nativo (OSD)
# igual al de volumen de altavoces, sin enviar notificaciones molestas.
# ==============================================================================

import sys
import re
import subprocess
import gi
gi.require_version('Gio', '2.0')
from gi.repository import Gio, GLib


def get_current_volume():
    try:
        res = subprocess.run(['pactl', 'get-source-volume', '@DEFAULT_SOURCE@'], capture_output=True, text=True)
        m = re.search(r'(\d+)%', res.stdout)
        return int(m.group(1)) if m else 80
    except Exception:
        return 80


def get_is_muted():
    try:
        res = subprocess.run(['pactl', 'get-source-mute', '@DEFAULT_SOURCE@'], capture_output=True, text=True)
        return 'yes' in res.stdout.lower()
    except Exception:
        return False


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else 'up'
    step = int(sys.argv[2]) if len(sys.argv) > 2 else 5
    max_vol = 150

    cur_vol = get_current_volume()
    is_muted = get_is_muted()

    if action == 'up':
        if is_muted:
            subprocess.run(['pactl', 'set-source-mute', '@DEFAULT_SOURCE@', '0'], capture_output=True)
            is_muted = False
        new_vol = min(max_vol, cur_vol + step)
        subprocess.run(['pactl', 'set-source-volume', '@DEFAULT_SOURCE@', f'{new_vol}%'], capture_output=True)
    elif action == 'down':
        new_vol = max(0, cur_vol - step)
        subprocess.run(['pactl', 'set-source-volume', '@DEFAULT_SOURCE@', f'{new_vol}%'], capture_output=True)
    elif action in ('toggle', 'mute'):
        subprocess.run(['pactl', 'set-source-mute', '@DEFAULT_SOURCE@', 'toggle'], capture_output=True)
        is_muted = not is_muted
        new_vol = cur_vol
    elif action == 'set':
        target = int(sys.argv[2]) if len(sys.argv) > 2 else 100
        new_vol = max(0, min(max_vol, target))
        subprocess.run(['pactl', 'set-source-volume', '@DEFAULT_SOURCE@', f'{new_vol}%'], capture_output=True)
    elif action == 'get':
        print(cur_vol)
        return
    else:
        print(f"Uso: {sys.argv[0]} {{up [paso]|down [paso]|toggle|set <porcentaje>|get}}")
        return

    # Selección de icono estándar de sensibilidad de micrófono de GNOME Shell
    level = 0.0 if (is_muted or new_vol == 0) else (new_vol / 100.0)
    if is_muted or new_vol == 0:
        icon_name = 'microphone-sensitivity-muted-symbolic'
    elif level <= 0.33:
        icon_name = 'microphone-sensitivity-low-symbolic'
    elif level <= 0.66:
        icon_name = 'microphone-sensitivity-medium-symbolic'
    else:
        icon_name = 'microphone-sensitivity-high-symbolic'

    # Mostrar la píldora OSD nativa de GNOME Shell sin notificaciones
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)

        def on_acquired(conn, _name):
            v_dict = GLib.Variant('a{sv}', {
                'icon': GLib.Variant('s', icon_name),
                'level': GLib.Variant('d', float(level)),
                'max-level': GLib.Variant('d', 1.5)
            })
            try:
                conn.call_sync(
                    'org.gnome.Shell',
                    '/org/gnome/Shell',
                    'org.gnome.Shell',
                    'ShowOSD',
                    GLib.Variant.new_tuple(v_dict),
                    None,
                    Gio.DBusCallFlags.NONE,
                    500,
                    None
                )
            except Exception:
                pass
            loop.quit()

        def on_lost(_conn, _name):
            loop.quit()

        loop = GLib.MainLoop()
        owner_id = Gio.bus_own_name_on_connection(
            bus,
            'org.gnome.Settings',
            Gio.BusNameOwnerFlags.ALLOW_REPLACEMENT,
            on_acquired,
            on_lost
        )
        # Timeout de seguridad
        GLib.timeout_add(300, loop.quit)
        loop.run()
        try:
            Gio.bus_unown_name(owner_id)
        except Exception:
            pass
    except Exception:
        pass


if __name__ == '__main__':
    main()
